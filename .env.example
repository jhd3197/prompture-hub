# --- prompture-hub config (HUB_* prefix) ---

# Bearer token protecting /admin/* endpoints. REQUIRED.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
HUB_ADMIN_TOKEN=

# SQLite DB path (relative to working dir or absolute).
HUB_DB_PATH=./prompture_hub.db

# Bind config. Keep host as 127.0.0.1 for localhost-only; change to 0.0.0.0 only
# when reverse-proxied behind nginx/Caddy with TLS + rate limits.
# Docker compose overrides these to 0.0.0.0:1984 and HUB_DB_PATH=/data/prompture_hub.db.
HUB_HOST=127.0.0.1
HUB_PORT=1984

# Comma-separated provider names to hide from /api/models. Useful when
# Prompture surfaces drivers you don't want to expose (internal routers,
# unfinished WIPs). Case-insensitive. Default hides cachibot.
HUB_DISABLED_PROVIDERS=cachibot

# Billing reconciliation (GET /admin/billing/reconciliation, dashboard Billing page).
# Org admin keys (not ordinary API keys) enable the OpenAI / Anthropic comparison;
# they are read from the environment and never stored by the hub.
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
# A difference is a mismatch only if it exceeds BOTH thresholds.
HUB_BILLING_TOLERANCE_PCT=10
HUB_BILLING_TOLERANCE_USD=0.50
# Seconds to reuse a result unless refresh=true.
HUB_BILLING_CACHE_SECONDS=300

# Prompt compression before each model call: off | lite.
# lite trims older oversized tool results and repeated system prompts.
HUB_COMPRESSION=off

# Trust X-Forwarded-For for per-key IP allowlists. Only enable behind
# a reverse proxy you control; otherwise clients can spoof their IP.
HUB_TRUST_PROXY_HEADERS=false

# Spend-cap enforcement. block = refuse models with no known prices (402);
# warn = allow them (X-Hub-Cost-Warning header, nothing reserved).
HUB_UNKNOWN_PRICING=block
# Output tokens assumed when reserving cost for a request with no max_tokens.
HUB_DEFAULT_OUTPUT_TOKEN_ESTIMATE=1024
# Expire a leaked in-flight cost reservation after this many seconds.
HUB_RESERVATION_TTL_SECONDS=900

# --- dashboard login (OAuth) ---
# Public URL this hub is reachable at (used to build OAuth callback URLs).
# In dev: http://localhost:1984 ; in prod: https://hub.yourdomain.com
HUB_BASE_URL=http://localhost:1984

# Required to enable any dashboard login. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
HUB_SESSION_SECRET=

# Comma-separated allowlist. EMPTY = nobody can log in (safe default).
HUB_ALLOWED_EMAILS=you@example.com

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {HUB_BASE_URL}/auth/google/callback
HUB_GOOGLE_CLIENT_ID=
HUB_GOOGLE_CLIENT_SECRET=

# GitHub OAuth — create at https://github.com/settings/developers
# Authorization callback URL: {HUB_BASE_URL}/auth/github/callback
HUB_GITHUB_CLIENT_ID=
HUB_GITHUB_CLIENT_SECRET=

# --- real provider keys (consumed by Prompture's drivers, never exposed to /v1 callers) ---

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
HUGGINGFACE_API_KEY=
MOONSHOT_API_KEY=
MODELSCOPE_API_KEY=
ZAI_API_KEY=

# Ollama is a local server, set its base URL instead of an API key.
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio is also local.
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Add any other provider env vars Prompture supports as your setup needs them.
